{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "classpath:/json-schemas/resumo-financeiro.schema.json",
   "title": "Resumo financeiro",
   "description": "Resume receitas, gastos, saldo e gastos por categoria de um mês ou ano",
   "type": "object",
   "properties": {
      "mes": {
         "type": "integer",
         "minimum": 1,
         "maximum": 12,
         "description": "Mês do resumo, de 1 a 12"
      },
      "ano": {
         "type": "integer",
         "minimum": 1,
         "description": "Ano do resumo"
      }
   },
   "required": ["ano"],
   "additionalProperties": false
}

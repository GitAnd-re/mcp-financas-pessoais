{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "classpath:/json-schemas/definir-orcamento.schema.json",
   "title": "Definir orçamento",
   "description": "Define ou atualiza o limite mensal de gastos de uma categoria",
   "type": "object",
   "properties": {
      "categoria": {
         "type": "string",
         "minLength": 1,
         "description": "Categoria do orçamento"
      },
      "mes": {
         "type": "integer",
         "minimum": 1,
         "maximum": 12,
         "description": "Mês ao qual o orçamento se aplica"
      },
      "ano": {
         "type": "integer",
         "minimum": 1,
         "description": "Ano ao qual o orçamento se aplica"
      },
      "limite_mensal": {
         "type": "number",
         "exclusiveMinimum": 0,
         "description": "Limite mensal positivo para a categoria"
      }
   },
   "required": ["categoria", "mes", "ano", "limite_mensal"],
   "additionalProperties": false
}
